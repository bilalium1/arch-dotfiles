/* MACOS SPOTLIGHT LIKE DARK THEME FOR ROFI  */
/* Author: Newman Sanchez (https://github.com/newmanls) */

@import "~/.config/rofi/wallust-colors.rasi"

* {
    font:   "Montserrat Medium 12";

    bg0:    #24242450;
    bg1:    @on-primary-fixed;
    bg2:    @primary;

    fg0:    @primary;
    fg1:    @secondary;
    fg2:    #DEDEDEaa;

    background-color:   @bg0;
    text-color:         @fg0;
    border-radius : 10px;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    background-color:   transparent;

    border: 0px;
    location:       center;
    width:          640;
    border-radius:  5;
}

inputbar {
    font:       "Montserrat Light 20";
    padding:    12px;
    spacing:    10px;
    children:   [ icon-search, entry ];
}

icon-search {
    background-color: transparent;
    expand:     false;
    filename:   "search.png";
    size: 20px;
    margin: 0 10px 0 10px;
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
	background-color: transparent;
    font:   inherit;

    placeholder         : "SEARCH";
    placeholder-color   : @fg1;
    text-color: @fg1;
}

message {
    border:             5px 0 0;
    border-color:       @fg1;
    background-color:   @fg1;
}

textbox {
    padding:    20px 40px;
}

listview {
    lines:      7;
    columns:    1;

    fixed-height:   false;
    border:         0px 0 0;
    border-color:   @bg2;
	padding: 20px;
}

element {
    border-radius :     5px;
    padding:            8px 16px;
    spacing:            30px;
    margin: 0 0 5px 5px;
    background-color:   transparent;
}

element normal active {
    text-color: @fg2;
}

element alternate active {
    text-color: @fg2;
}

element selected normal, element selected active {
    background-color:   @bg2;
    text-color:         @fg1;
}

element-icon {
    size:   1em;
}

element-text {
    text-color: inherit;
}

