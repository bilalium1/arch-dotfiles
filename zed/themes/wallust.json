{
  "name": "Wallust",
  "author": "you",
  "themes": [
    {
      "name": "Wallust Dark",
      "appearance": "dark",
      "style": {
        /* ─── base ─── */
        "background": "#191414",
        "text": "#F3D9C4",
        "muted": "#A08772",
        "border": "#A08772",

        /* ─── surfaces ─── */
        "panel.background": "#453E3E",
        "panel.focused_border": "#865539",
        "pane.background": "#191414",
        "scrollbar.thumb": "#A08772",

        /* ─── editor ─── */
        "editor.background": "#191414",
        "editor.foreground": "#F3D9C4",
        "editor.gutter": "#453E3E",
        "editor.line_number": "#A08772",
        "editor.active_line_number": "#E5C1A3",
        "editor.current_line": "#453E3E",
        "editor.selection": "#865539",
        "editor.cursor": "#865539",
        "editor.invisible": "#A08772",
        "editor.wrap_guide": "#453E3E",

        /* ─── search / highlights ─── */
        "editor.search_match": "#453E3E",
        "editor.search_match_background": "#2E5252",
        "editor.highlighted_line": "#453E3E",

        /* ─── diagnostics ─── */
        "error": "#59342D",
        "warning": "#2E5252",
        "info": "#865539",
        "hint": "#AA6730",

        /* ─── git ─── */
        "version_control.added": "#304F4F",
        "version_control.modified": "#865539",
        "version_control.deleted": "#59342D",

        /* ─── terminal ─── */
        "terminal.background": "#191414",
        "terminal.foreground": "#F3D9C4",

        "terminal.ansi.black": "#453E3E",
        "terminal.ansi.red": "#59342D",
        "terminal.ansi.green": "#304F4F",
        "terminal.ansi.yellow": "#2E5252",
        "terminal.ansi.blue": "#865539",
        "terminal.ansi.magenta": "#A36739",
        "terminal.ansi.cyan": "#AA6730",
        "terminal.ansi.white": "#E5C1A3",

        "terminal.ansi.bright_black": "#A08772",
        "terminal.ansi.bright_red": "#643730",
        "terminal.ansi.bright_green": "#335656",
        "terminal.ansi.bright_yellow": "#315B59",
        "terminal.ansi.bright_blue": "#A0643F",
        "terminal.ansi.bright_magenta": "#C67433",
        "terminal.ansi.bright_cyan": "#DC8239",
        "terminal.ansi.bright_white": "#E5C1A3",

        /* ─── syntax ─── */
        "syntax": {
          "attribute": { "color": "#AA6730" },
          "boolean": { "color": "#2E5252" },
          "character": { "color": "#304F4F" },

          "comment": {
            "color": "#A08772",
            "font_style": "italic"
          },

          "constant": { "color": "#2E5252" },
          "constructor": { "color": "#A36739" },
          "function": { "color": "#A36739" },

          "keyword": {
            "color": "#59342D",
            "font_style": "bold"
          },

          "label": { "color": "#865539" },
          "number": { "color": "#2E5252" },

          "operator": { "color": "#F3D9C4" },

          "parameter": { "color": "#AA6730" },
          "property": { "color": "#AA6730" },

          "punctuation": { "color": "#A08772" },

          "string": { "color": "#304F4F" },
          "string.escape": { "color": "#59342D" },

          "tag": { "color": "#59342D" },

          "type": { "color": "#865539" },
          "type.builtin": { "color": "#865539" },

          "variable": { "color": "#F3D9C4" },
          "variable.builtin": { "color": "#865539" }
        }
      }
    }
  ]
}
