{
  "name": "Wallust",
  "author": "you",
  "themes": [
    {
      "name": "Wallust Dark",
      "appearance": "dark",
      "style": {
        /* ─── base & global borders ─── */
        "background": "#0E0E14a5",
        "text": "#D0DDEE",
        "muted": "#7E8B9C",
        "border": null,
        "border.variant": null,
        "border.focused": null,
        "border.selected": null,
        "border.disabled": null,
        /* ─── unified surfaces (panels, sidebars, popups) ─── */
        "panel.background": "#0E0E14a5",
        "panel.focused_border": null,
        "pane.background": "#0E0E14a5",
        "pane_group.border": null,
        "element.background": "#0E0E14a5",
        "element.hover": "#39393F",
        "element.active": "#39393F",
        "ghost_element.background": "#0E0E14a5",
        "ghost_element.hover": "#39393F",
        "ghost_element.active": "#39393F",
        "drop_target.background": "#0E0E14a5",
        "scrollbar.thumb": null,
        /* ─── statusbar & titlebar ─── */
        "status_bar.background": "#0E0E14a5",
        "title_bar.background": "#0E0E14a5",
        "title_bar.inactive_background": "#0E0E14a5",
        "toolbar.background": "#0E0E14a5",
        /* ─── tabs & project panel (file tree) ─── */
        "tab_bar.background": "#0E0E14a5",
        "tab.active_background": "#0E0E14a5",
        "tab.inactive_background": "#0E0E14a5",
        "project_panel.background": "#0E0E14a5",
        "outline_panel.background": "#0E0E14a5",
        /* ─── editor & gutter ─── */
        "editor.background": "#0E0E1455",
        "editor.foreground": "#D0DDEE",
        "editor.gutter": "#0E0E1455",
        "editor.line_number": "#7E8B9C",
        "editor.active_line_number": "#B4C7DF",
        "editor.current_line": null,
        "editor.selection": "#35669040",
        "editor.cursor": "#356690",
        "editor.invisible": "#7E8B9C",
        "editor.wrap_guide": null,
        "editor.active_wrap_guide": null,
        /* ─── search / highlights ─── */
        "editor.search_match": "#39393F",
        "editor.search_match_background": "#34638C40",
        "editor.highlighted_line": null,
        /* ─── diagnostics ─── */
        "error": "#283352",
        "warning": "#34638C",
        "info": "#356690",
        "hint": "#416AA0",
        /* ─── git ─── */
        "version_control.added": "#2A3F5E",
        "version_control.modified": "#356690",
        "version_control.deleted": "#283352",
        /* ─── terminal ─── */
        "terminal.background": "#0E0E1412",
        "terminal.foreground": "#D0DDEE",
        "terminal.ansi.black": "#39393F",
        "terminal.ansi.red": "#283352",
        "terminal.ansi.green": "#2A3F5E",
        "terminal.ansi.yellow": "#34638C",
        "terminal.ansi.blue": "#356690",
        "terminal.ansi.magenta": "#9E49A4",
        "terminal.ansi.cyan": "#416AA0",
        "terminal.ansi.white": "#B4C7DF",
        "terminal.ansi.bright_black": "#7E8B9C",
        "terminal.ansi.bright_red": "#29365B",
        "terminal.ansi.bright_green": "#2C446A",
        "terminal.ansi.bright_yellow": "#3974A8",
        "terminal.ansi.bright_blue": "#3473A9",
        "terminal.ansi.bright_magenta": "#B846BF",
        "terminal.ansi.bright_cyan": "#4F87CF",
        "terminal.ansi.bright_white": "#B4C7DF",
        /* ─── syntax ─── */
        "syntax": {
          "attribute": { "color": "#416AA0" },
          "boolean": { "color": "#34638C" },
          "character": { "color": "#2A3F5E" },
          "comment": {
            "color": "#7E8B9C",
            "font_style": "italic"
          },
          "constant": { "color": "#34638C" },
          "constructor": { "color": "#9E49A4" },
          "function": { "color": "#9E49A4" },
          "keyword": {
            "color": "#283352",
            "font_style": "bold"
          },
          "label": { "color": "#356690" },
          "number": { "color": "#34638C" },
          "operator": { "color": "#D0DDEE" },
          "parameter": { "color": "#416AA0" },
          "property": { "color": "#416AA0" },
          "punctuation": { "color": "#7E8B9C" },
          "string": { "color": "#2A3F5E" },
          "string.escape": { "color": "#283352" },
          "tag": { "color": "#283352" },
          "type": { "color": "#356690" },
          "type.builtin": { "color": "#356690" },
          "variable": { "color": "#D0DDEE" },
          "variable.builtin": { "color": "#356690" }
        }
      }
    }
  ]
}
