{
  "name": "Wallust",
  "author": "you",
  "themes": [
    {
      "name": "Wallust Dark",
      "appearance": "dark",
      "style": {
        /* ─── base & global borders ─── */
        "background": "#0F0F0Fa5",
        "text": "#C9C6C8",
        "muted": "#767476",
        "border": null,
        "border.variant": null,
        "border.focused": null,
        "border.selected": null,
        "border.disabled": null,
        /* ─── unified surfaces (panels, sidebars, popups) ─── */
        "panel.background": "#0F0F0Fa5",
        "panel.focused_border": null,
        "pane.background": "#0F0F0Fa5",
        "pane_group.border": null,
        "element.background": "#0F0F0Fa5",
        "element.hover": "#3A3A3A",
        "element.active": "#3A3A3A",
        "ghost_element.background": "#0F0F0Fa5",
        "ghost_element.hover": "#3A3A3A",
        "ghost_element.active": "#3A3A3A",
        "drop_target.background": "#0F0F0Fa5",
        "scrollbar.thumb": null,
        /* ─── statusbar & titlebar ─── */
        "status_bar.background": "#0F0F0Fa5",
        "title_bar.background": "#0F0F0Fa5",
        "title_bar.inactive_background": "#0F0F0Fa5",
        "toolbar.background": "#0F0F0Fa5",
        /* ─── tabs & project panel (file tree) ─── */
        "tab_bar.background": "#0F0F0Fa5",
        "tab.active_background": "#0F0F0Fa5",
        "tab.inactive_background": "#0F0F0Fa5",
        "project_panel.background": "#0F0F0Fa5",
        "outline_panel.background": "#0F0F0Fa5",
        /* ─── editor & gutter ─── */
        "editor.background": "#0F0F0F55",
        "editor.foreground": "#C9C6C8",
        "editor.gutter": "#0F0F0F55",
        "editor.line_number": "#767476",
        "editor.active_line_number": "#A9A5A9",
        "editor.current_line": null,
        "editor.selection": "#70383440",
        "editor.cursor": "#703834",
        "editor.invisible": "#767476",
        "editor.wrap_guide": null,
        "editor.active_wrap_guide": null,
        /* ─── search / highlights ─── */
        "editor.search_match": "#3A3A3A",
        "editor.search_match_background": "#70383440",
        "editor.highlighted_line": null,
        /* ─── diagnostics ─── */
        "error": "#482D2D",
        "warning": "#703834",
        "info": "#703834",
        "hint": "#74486C",
        /* ─── git ─── */
        "version_control.added": "#482E48",
        "version_control.modified": "#703834",
        "version_control.deleted": "#482D2D",
        /* ─── terminal ─── */
        "terminal.background": "#0F0F0F12",
        "terminal.foreground": "#C9C6C8",
        "terminal.ansi.black": "#3A3A3A",
        "terminal.ansi.red": "#482D2D",
        "terminal.ansi.green": "#482E48",
        "terminal.ansi.yellow": "#703834",
        "terminal.ansi.blue": "#703834",
        "terminal.ansi.magenta": "#714768",
        "terminal.ansi.cyan": "#74486C",
        "terminal.ansi.white": "#A9A5A9",
        "terminal.ansi.bright_black": "#767476",
        "terminal.ansi.bright_red": "#4C2F35",
        "terminal.ansi.bright_green": "#4C314C",
        "terminal.ansi.bright_yellow": "#823D38",
        "terminal.ansi.bright_blue": "#823D38",
        "terminal.ansi.bright_magenta": "#83517D",
        "terminal.ansi.bright_cyan": "#814F7B",
        "terminal.ansi.bright_white": "#A9A5A9",
        /* ─── syntax ─── */
        "syntax": {
          "attribute": { "color": "#74486C" },
          "boolean": { "color": "#703834" },
          "character": { "color": "#482E48" },
          "comment": {
            "color": "#767476",
            "font_style": "italic"
          },
          "constant": { "color": "#703834" },
          "constructor": { "color": "#714768" },
          "function": { "color": "#714768" },
          "keyword": {
            "color": "#482D2D",
            "font_style": "bold"
          },
          "label": { "color": "#703834" },
          "number": { "color": "#703834" },
          "operator": { "color": "#C9C6C8" },
          "parameter": { "color": "#74486C" },
          "property": { "color": "#74486C" },
          "punctuation": { "color": "#767476" },
          "string": { "color": "#482E48" },
          "string.escape": { "color": "#482D2D" },
          "tag": { "color": "#482D2D" },
          "type": { "color": "#703834" },
          "type.builtin": { "color": "#703834" },
          "variable": { "color": "#C9C6C8" },
          "variable.builtin": { "color": "#703834" }
        }
      }
    }
  ]
}
