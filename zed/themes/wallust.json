{
  "name": "Wallust",
  "author": "you",
  "themes": [
    {
      "name": "Wallust Dark",
      "appearance": "dark",
      "style": {
        /* ─── base & global borders ─── */
        "background": "#161615a5",
        "text": "#E4E4E6",
        "muted": "#929294",
        "border": null,
        "border.variant": null,
        "border.focused": null,
        "border.selected": null,
        "border.disabled": null,
        /* ─── unified surfaces (panels, sidebars, popups) ─── */
        "panel.background": "#161615a5",
        "panel.focused_border": null,
        "pane.background": "#161615a5",
        "pane_group.border": null,
        "element.background": "#161615a5",
        "element.hover": "#414040",
        "element.active": "#414040",
        "ghost_element.background": "#161615a5",
        "ghost_element.hover": "#414040",
        "ghost_element.active": "#414040",
        "drop_target.background": "#161615a5",
        "scrollbar.thumb": null,
        /* ─── statusbar & titlebar ─── */
        "status_bar.background": "#161615a5",
        "title_bar.background": "#161615a5",
        "title_bar.inactive_background": "#161615a5",
        "toolbar.background": "#161615a5",
        /* ─── tabs & project panel (file tree) ─── */
        "tab_bar.background": "#161615a5",
        "tab.active_background": "#161615a5",
        "tab.inactive_background": "#161615a5",
        "project_panel.background": "#161615a5",
        "outline_panel.background": "#161615a5",
        /* ─── editor & gutter ─── */
        "editor.background": "#16161555",
        "editor.foreground": "#E4E4E6",
        "editor.gutter": "#16161555",
        "editor.line_number": "#929294",
        "editor.active_line_number": "#D1D1D4",
        "editor.current_line": null,
        "editor.selection": "#4E5A8D40",
        "editor.cursor": "#4E5A8D",
        "editor.invisible": "#929294",
        "editor.wrap_guide": null,
        "editor.active_wrap_guide": null,
        /* ─── search / highlights ─── */
        "editor.search_match": "#414040",
        "editor.search_match_background": "#76503940",
        "editor.highlighted_line": null,
        /* ─── diagnostics ─── */
        "error": "#4B3C2E",
        "warning": "#765039",
        "info": "#4E5A8D",
        "hint": "#57578B",
        /* ─── git ─── */
        "version_control.added": "#4D3C2F",
        "version_control.modified": "#4E5A8D",
        "version_control.deleted": "#4B3C2E",
        /* ─── terminal ─── */
        "terminal.background": "#16161512",
        "terminal.foreground": "#E4E4E6",
        "terminal.ansi.black": "#414040",
        "terminal.ansi.red": "#4B3C2E",
        "terminal.ansi.green": "#4D3C2F",
        "terminal.ansi.yellow": "#765039",
        "terminal.ansi.blue": "#4E5A8D",
        "terminal.ansi.magenta": "#9B6C40",
        "terminal.ansi.cyan": "#57578B",
        "terminal.ansi.white": "#D1D1D4",
        "terminal.ansi.bright_black": "#929294",
        "terminal.ansi.bright_red": "#503E31",
        "terminal.ansi.bright_green": "#543F32",
        "terminal.ansi.bright_yellow": "#8A5A3F",
        "terminal.ansi.bright_blue": "#505C9B",
        "terminal.ansi.bright_magenta": "#B8783E",
        "terminal.ansi.bright_cyan": "#7474B9",
        "terminal.ansi.bright_white": "#D1D1D4",
        /* ─── syntax ─── */
        "syntax": {
          "attribute": { "color": "#57578B" },
          "boolean": { "color": "#765039" },
          "character": { "color": "#4D3C2F" },
          "comment": {
            "color": "#929294",
            "font_style": "italic"
          },
          "constant": { "color": "#765039" },
          "constructor": { "color": "#9B6C40" },
          "function": { "color": "#9B6C40" },
          "keyword": {
            "color": "#4B3C2E",
            "font_style": "bold"
          },
          "label": { "color": "#4E5A8D" },
          "number": { "color": "#765039" },
          "operator": { "color": "#E4E4E6" },
          "parameter": { "color": "#57578B" },
          "property": { "color": "#57578B" },
          "punctuation": { "color": "#929294" },
          "string": { "color": "#4D3C2F" },
          "string.escape": { "color": "#4B3C2E" },
          "tag": { "color": "#4B3C2E" },
          "type": { "color": "#4E5A8D" },
          "type.builtin": { "color": "#4E5A8D" },
          "variable": { "color": "#E4E4E6" },
          "variable.builtin": { "color": "#4E5A8D" }
        }
      }
    }
  ]
}
